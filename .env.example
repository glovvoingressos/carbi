# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── FIPE API ────────────────────────────────────────────────
FIPE_API_TOKEN=
NEXT_PUBLIC_FIPE_API_BASE_URL=https://fipe.parallelum.com.br/api/v2

# ─── AutoDev enrichment ──────────────────────────────────────
AUTODEV_API_KEY=

# ─── Google (Vision API - plate blur) ────────────────────────
GOOGLE_API_KEY=

# ─── Resend (transactional emails) ───────────────────────────
# Produção: RESEND_API_KEY e RESEND_FROM_EMAIL são obrigatórias para envio de e-mails.
# IMPORTANTE: o domínio do remetente DEVE estar verificado no painel do Resend.
# Mantenha estas variáveis apenas no servidor; nunca use o prefixo NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Carbi <noreply@carbi.com.br>"
ADMIN_NOTIFY_EMAIL=

# ─── Chat de suporte ─────────────────────────────────────────
# Produção: SUPPORT_ADMIN_EMAILS e ADMIN_NOTIFY_EMAIL são obrigatórias para acesso administrativo e notificações.
# RESEND_API_KEY e RESEND_FROM_EMAIL (acima) também são obrigatórias para o envio dessas notificações.
# Lista de e-mails de administradores do suporte, separados por vírgula.
# ADMIN_NOTIFY_EMAIL recebe as notificações de novas conversas.
# Mantenha estes endereços e as credenciais do Resend somente no servidor.
SUPPORT_ADMIN_EMAILS=

# ─── Google Analytics ────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── OpenRouter (AI description formatting & generation) ─────
OPENROUTER_API_KEY=

# ─── Deploy ──────────────────────────────────────────────────
# Site público usado pelo OpenRouter para identificar a origem das requisições.
NEXT_PUBLIC_SITE_URL=https://carbi.com.br
